{
  "name": "note-api-client",
  "version": "0.1.0",
  "description": "A comprehensive Node.js and TypeScript client library for note.com API - Search notes, manage content, handle authentication, and automate your note.com workflow with full TypeScript support",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "homepage": "https://github.com/RenKoya1/note-api-client",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist', '.test-build']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "build:test": "npm run clean && tsc -p . --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --test-concurrency=1 \".test-build/test/unit/**/*.test.js\"",
    "test:live": "npm run build:test && node --test --test-concurrency=1 --test-timeout=600000 \".test-build/test/live/**/*.test.js\"",
    "prepublishOnly": "npm test && npm run build",
    "release": "npm publish --access=public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "note",
    "note.com",
    "note-api",
    "api",
    "api-client",
    "typescript",
    "library",
    "client"
  ],
  "author": "",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "https-proxy-agent": "^7.0.6",
    "image-size": "^2.0.4"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.15.30",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3"
  },
  "types": "dist/index.d.ts"
}
